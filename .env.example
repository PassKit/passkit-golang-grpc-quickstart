# Copy to .env and add your own values. Never commit .env or PEM files.
PASSKIT_GRPC_HOST=grpc.pub1.passkit.io
PASSKIT_GRPC_PORT=443
PASSKIT_CERTIFICATE=certs/certificate.pem
PASSKIT_KEY=certs/key.pem
PASSKIT_CA_CHAIN=certs/ca-chain.pem
PASSKIT_EMAIL=you@example.com
PASSKIT_APPLE_CERTIFICATE_ID=
PASSKIT_POOL_SIZE=4
PASSKIT_CLEANUP_DELAY_SECONDS=0
